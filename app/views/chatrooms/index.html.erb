<div class="flex h-screen">
  <div id="map" data-controller="map" class="w-2/3 h-full">
    <% @chatrooms.each do |chatroom| %>
      <span data-map-target="marker"
            data-chatroom-id="<%= chatroom.id %>"
            data-latitude="<%= chatroom.latitude %>"
            data-longitude="<%= chatroom.longitude %>"
            data-title="<%= chatroom.title %>"
            hidden></span>
    <% end %>
  </div>

  <div class="w-1/3 h-full border-l overflow-y-auto">
    <%= turbo_frame_tag "panel" do %>
      <p class="p-4 text-gray-500">Click on the map to start a chat</p>
    <% end %>
  </div>
</div>
